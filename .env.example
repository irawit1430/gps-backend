# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
TCP_PORT=5000
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────
# Postgres (production). Self-hosted Postgres on the same VM (Cloud SQL no longer used):
#   postgresql://voltava:PASSWORD@localhost:5432/voltava_fleet?schema=public
# Or SQLite for local/staging:
#   file:./dev.db
DATABASE_URL=postgresql://voltava:CHANGEME@localhost:5432/voltava_fleet?schema=public

# ─── Auth ───────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=24h

# ─── CORS (comma-separated origins) ─────────────────────────
# rytfull-media01.web.app is the school dashboard's ACTUAL deploy target — it is the
# only Firebase Hosting project that session has credentials for, and no one has DNS
# for school.voltava.in yet. Both are listed because dropping the web.app origin makes
# the dashboard look completely dead: every call fails CORS with no clue why.
CORS_ORIGINS=https://school.voltava.in,https://maindashboard.voltava.in,https://rytfull-media01.web.app

# ─── Firebase (service account JSON, base64 or raw) ─────────
# Base64: base64 -w0 firebase-key.json
FIREBASE_SERVICE_ACCOUNT=

# ─── Device telemetry authentication ────────────────────────
# HMAC secret shared with per-device secrets stored in Bus.deviceSecret.
# If unset, /api/telemetry HMAC verification is DISABLED (dev only).
TELEMETRY_HMAC_ENFORCE=1
# Max clock skew allowed on device timestamps (seconds)
TELEMETRY_MAX_SKEW_SECONDS=300

# ─── Boot-time behavior (all default to off) ────────────────
# Run `prisma migrate deploy` on boot. Only enable on first deploy or during release.
RUN_MIGRATIONS=0
# Allow the seed script to run. Never enable in prod unless you intend to seed.
ALLOW_SEED=0
# Seed admin credentials (required if ALLOW_SEED=1). No defaults.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Enable mock notifications / fake stat fallbacks. STAGING ONLY.
ENABLE_MOCK_DATA=0

# ─── Parent onboarding ──────────────────────────────────────
# Shared opening password for every parent account the system creates, so a school can
# onboard hundreds of families with one line on a notice. Leave it EMPTY to give each
# parent their own 12-character password instead (returned by the import, one per row).
#
# When set, this one string opens every parent account created since it was last
# changed, and each of those accounts shows a child's live location. mustResetPassword
# is advisory only, so a family that never changes it stays open indefinitely. Rotate
# after every import, and treat a leaked slip as a reason to rotate immediately.
#
# Set the real value in .env, which is gitignored. This repo is public: a value written
# here is published, stays in the history after it is deleted, and is the opening
# password for accounts that show a child's live position.
PARENT_DEFAULT_PASSWORD=

# ─── Rate limiting ──────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_GLOBAL_PER_MIN=300
