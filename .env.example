# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
TCP_PORT=5000
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────
# Postgres (production). Self-hosted Postgres on the same VM (Cloud SQL no longer used):
#   postgresql://voltava:PASSWORD@localhost:5432/voltava_fleet?schema=public
# Or SQLite for local/staging:
#   file:./dev.db
DATABASE_URL=postgresql://voltava:CHANGEME@localhost:5432/voltava_fleet?schema=public

# ─── Auth ───────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=24h

# ─── CORS (comma-separated origins) ─────────────────────────
# rytfull-media01.web.app is the school dashboard's ACTUAL deploy target — it is the
# only Firebase Hosting project that session has credentials for, and no one has DNS
# for school.voltava.in yet. Both are listed because dropping the web.app origin makes
# the dashboard look completely dead: every call fails CORS with no clue why.
CORS_ORIGINS=https://school.voltava.in,https://maindashboard.voltava.in,https://rytfull-media01.web.app

# ─── Firebase (service account JSON, base64 or raw) ─────────
# Base64: base64 -w0 firebase-key.json
FIREBASE_SERVICE_ACCOUNT=

# ─── iPhone push (Apple) ────────────────────────────────────
# Apple Developer > Certificates, IDs & Profiles > Keys: make a key with Apple Push
# Notifications service, download the .p8 once. Paste its contents (or base64 of the
# file) as APNS_KEY. All four must be set, or iPhone push stays off.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.voltava.in
# 1 for App Store / TestFlight builds, 0 for development builds.
APNS_PRODUCTION=1

# ─── Device telemetry authentication ────────────────────────
# HMAC secret shared with per-device secrets stored in Bus.deviceSecret.
# If unset, /api/telemetry HMAC verification is DISABLED (dev only).
TELEMETRY_HMAC_ENFORCE=1
# Max clock skew allowed on device timestamps (seconds)
TELEMETRY_MAX_SKEW_SECONDS=300

# ─── Boot-time behavior (all default to off) ────────────────
# Run `prisma migrate deploy` on boot. Only enable on first deploy or during release.
RUN_MIGRATIONS=0
# Allow the seed script to run. Never enable in prod unless you intend to seed.
ALLOW_SEED=0
# Seed admin credentials (required if ALLOW_SEED=1). No defaults.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Enable mock notifications / fake stat fallbacks. STAGING ONLY.
ENABLE_MOCK_DATA=0

# ─── Parent invites ─────────────────────────────────────────
# Every family gets its own one-time code (the school sends it from the dashboard's
# Parents page). Days a code keeps working:
PARENT_INVITE_DAYS=7
# The store pages the invite links to. Leave empty until the listings are live: the
# invite then says "find Voltava on the Play Store", and the school's readiness page
# says the links are missing.
PARENT_APP_ANDROID_URL=
PARENT_APP_IOS_URL=
# PARENT_DEFAULT_PASSWORD is retired and ignored: one shared opening password opened
# every unclaimed family account. Remove it from .env if it is still there.

# ─── Rate limiting ──────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_GLOBAL_PER_MIN=300

# Cancel planned trips that were due more than TRIP_STALE_HOURS (default 12) ago and never
# started. Off by default: while off, the log says how many it WOULD cancel each hour.
# Check that number, then set to 1.
STALE_TRIP_SWEEP=0

# ─── Parent ETAs ────────────────────────────────────────────
# Minutes the bus waits at each stop. Route stop times are pure driving time, so ETAs
# add this for every stop before yours. 0 turns it off.
STOP_DWELL_MINUTES=1
# Parents get "bus almost at your stop" when the bus is this many minutes away. 0 = off.
APPROACH_ALERT_MINUTES=5

# ─── School alerts ──────────────────────────────────────────
# A trip that has sent no GPS at all this many minutes after it started is reported
# to the school's admins ("Trip running with no GPS"). 0 = off.
TRACKING_CONFIRM_MINUTES=3
# Refuse a driver's trip start until the bus's GPS has reached the server in the last
# TRIP_START_FIX_SECONDS (or the driver gives a reason to start without). The new driver
# app already waits for GPS; turn this on once every driver phone has that app.
TRIP_START_REQUIRES_GPS=0
TRIP_START_FIX_SECONDS=120

# ─── Whole-system alarms (to super admins: bell, push, email, error log) ─────────
# No GPS from any bus for this many minutes while trips are running. 0 = off.
SYSTEM_GPS_SILENCE_MINUTES=10
# Push failing: this share of pushes failed in the window, out of at least MIN_ATTEMPTS.
SYSTEM_PUSH_WINDOW_MINUTES=30
SYSTEM_PUSH_MIN_ATTEMPTS=20
SYSTEM_PUSH_FAIL_RATE=0.5
# Per device for GPS, and a per-address ceiling far above any one user (many phones
# share one mobile-operator address).
RATE_LIMIT_TELEMETRY_PER_DEVICE_PER_MIN=120
RATE_LIMIT_PER_IP_PER_MIN=6000
