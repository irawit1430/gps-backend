generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────
enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  DRIVER
  PARENT
}

enum TripStatus {
  PLANNED
  ON_SCHEDULE
  DELAYED
  COMPLETED
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceType {
  BOARDED
  ALIGHTED
  // A child who was not at their stop. Until now this was indistinguishable from a
  // driver who forgot to scan, which made the record unreliable in exactly the case
  // a school later needs it to be exact. It is also the only notification in this
  // product with a window in which a parent can still act.
  NO_SHOW
}

// How a row came to exist. A scan and an office correction assert the same fact but
// with different confidence, and a school reconstructing a disputed day needs to tell
// them apart. MANUAL also suppresses the parent notification — backfilling a missed
// 07:38 scan at 15:02 must not push "your child boarded" to a family hours later.
enum AttendanceSource {
  SCAN
  MANUAL
}

enum EmergencyType {
  DRIVER_SOS
  HARDWARE_SOS
  ADMIN_BROADCAST
  DELAY
}

enum EmergencyStatus {
  ACTIVE
  RESOLVED
}

enum NotificationType {
  ARRIVAL
  BOARDING
  DELAY
  SYSTEM
  LEAVE
  SOS
}

// ─── Models ─────────────────────────────────────────────────────────────
model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  password             String
  role                 Role
  name                 String
  phone                String?  // contact number; for drivers this is what parents dial
  photoUrl             String?
  fcmToken             String?  // FCM push token — never returned by the API
  notificationSettings Json?
  mustResetPassword    Boolean  @default(false)
  schoolId             String?
  school               School?  @relation(fields: [schoolId], references: [id])
  lastLoginAt   DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  parentStudents Student[]      @relation("ParentStudents")
  driverTrips    Trip[]         @relation("DriverTrips")
  notifications  Notification[]
  passwordResetRequests PasswordResetRequest[]

  @@index([schoolId])
  @@index([role])
}

model School {
  id            String   @id @default(uuid())
  name          String
  address       String?
  contactPerson String?
  city          String?
  state         String?
  phone         String?
  email         String?
  contactEmail  String?
  contactPhone  String?
  website       String?
  pincode       String?
  latitude      Float?
  longitude     Float?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users    User[]
  buses    Bus[]
  routes   Route[]
  students Student[]
}

model Bus {
  id           String   @id @default(uuid())
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id])
  licensePlate String   @unique
  capacity     Int
  deviceId     String   @unique
  deviceSecret String?  // HMAC secret for /api/telemetry authentication
  status        String   @default("ONLINE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips   Trip[]
  gpsLogs GpsLog[]

  @@index([schoolId])
}

model Route {
  id                String   @id @default(uuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  name              String
  estimatedDuration Int?     // minutes, whole route
  distanceKm        Float?   // total driving distance
  geometry          String?  // OSRM-encoded polyline for map rendering
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stops RouteStop[]
  trips Trip[]

  @@index([schoolId])
}

model RouteStop {
  id                      String   @id @default(uuid())
  routeId                 String
  route                   Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name                    String
  address                 String?  // reverse-geocoded human-readable address
  lat                     Float
  lng                     Float
  orderIdx                Int
  expectedArrivalMinutes  Int?     // offset from trip start
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  studentMappings StudentRouteMapping[]

  @@index([routeId, orderIdx])
}

model Student {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  rfidTag   String   @unique
  name      String
  grade     String?
  photoUrl  String?
  guardianPhone String?  // fallback contact when the parent account has no phone

  // Scannable identity. Random by default; a school that already issues ID cards can
  // import its own codes instead, because telling them to reprint 600 cards destroys
  // the entire cost argument for QR over RFID.
  //
  // Unique per SCHOOL, not globally: imported codes are roll numbers and admission
  // numbers, and two schools will both have an "R042". Matching is already
  // school-scoped so this costs nothing.
  //
  // Never leaves the server except via the card-printing endpoint. The driver roster
  // carries a SHA-256 of it instead, so a phone can verify a card offline without
  // ever holding the credential that makes one.
  qrToken        String?
  // True when the school brought its own code, so no card needs printing for them.
  qrCodeImported Boolean @default(false)
  // Stamped by the card-printing endpoint as a side effect of printing, so it cannot
  // be forgotten the way a checkbox can. Two readers: the office needs it to reprint
  // one lost card instead of reissuing 75 sheets, and the driver app needs it to know
  // a card physically exists — a token in the database is not a card in a child's
  // hand, and backfilling tokens made every roster claim otherwise.
  qrCardPrintedAt DateTime?
  parentId  String?
  parent    User?    @relation("ParentStudents", fields: [parentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routeMappings     StudentRouteMapping[]
  attendanceLogs    AttendanceLog[]
  leaveApplications LeaveApplication[]

  @@unique([schoolId, qrToken])
  @@index([schoolId])
  @@index([parentId])
}

model StudentRouteMapping {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routeStopId String
  routeStop   RouteStop @relation(fields: [routeStopId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([studentId, routeStopId])
  @@index([routeStopId])
}

model Trip {
  id                String     @id @default(uuid())
  routeId           String
  route             Route      @relation(fields: [routeId], references: [id])
  busId             String
  bus               Bus        @relation(fields: [busId], references: [id])
  driverId          String
  driver            User       @relation("DriverTrips", fields: [driverId], references: [id])
  status            TripStatus @default(PLANNED)
  scheduledStart    DateTime?  // planned departure; anchors stop ETAs before start
  progressPercent   Int        @default(0)
  delayMinutes      Int        @default(0)
  currentEtaMessage String?
  startTime         DateTime?
  endTime           DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  gpsLogs        GpsLog[]
  attendanceLogs AttendanceLog[]

  @@index([driverId, status])
  @@index([busId, status])
  @@index([routeId, status])
}

model GpsLog {
  id        String   @id @default(uuid())
  busId     String
  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id])
  lat       Float
  lng       Float
  speed     Float    @default(0)
  timestamp DateTime @default(now())

  @@index([busId, timestamp(sort: Desc)])
  @@index([timestamp])
}

model AttendanceLog {
  id        String         @id @default(uuid())
  studentId String
  student   Student        @relation(fields: [studentId], references: [id])
  tripId    String
  trip      Trip           @relation(fields: [tripId], references: [id])
  type      AttendanceType
  source    AttendanceSource @default(SCAN)
  timestamp DateTime       @default(now())

  @@index([studentId, timestamp])
  @@index([tripId, timestamp])
  // "Every scan in this school today" — the students list and the parent payload both
  // ask it on every load. Neither index above serves it: both lead with an id, and
  // this query has neither. Today's rows are a tiny slice of the table, so a range
  // scan on timestamp and then a join is the right plan; without this it degrades to
  // reading the whole table as attendance accumulates.
  @@index([timestamp])
}

model LeaveApplication {
  id        String      @id @default(uuid())
  studentId String
  student   Student     @relation(fields: [studentId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String
  notes     String?
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([studentId, status])
  @@index([status, createdAt(sort: Desc)])
}

// A user asked for a password reset. There is no mail sender in this stack, so the
// request is queued for a school admin to approve and hand the temp password over
// in person / by phone, rather than emailing a code.
model PasswordResetRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId    String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  resolvedBy  String?   // admin user id
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId, status])
  @@index([userId, status])
}

model EmergencyAlert {
  id        String          @id @default(uuid())
  schoolId  String
  type      EmergencyType
  message   String?
  senderId  String?
  tripId    String?
  status    EmergencyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([schoolId, status])
  @@index([createdAt(sort: Desc)])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
}

model GlobalSettings {
  id              String   @id @default("global")
  maintenanceMode Boolean  @default(false)
  mapCenterLat    Float    @default(28.7041)
  mapCenterLng    Float    @default(77.1025)
  mapDefaultZoom      Int?
  overspeedLimitKph   Int?
  offlineAlertMinutes Int?
  alertEmail          String?
  updatedAt       DateTime @updatedAt
}
