// SQLite schema for local / staging.
// The canonical schema is prisma/schema.postgresql.prisma.
// Kept structurally in sync; SQLite lacks Prisma enum + Json support so those
// fields are String here and validated at the application layer.

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  password             String
  role                 String // "SUPER_ADMIN" | "SCHOOL_ADMIN" | "DRIVER" | "PARENT"
  name                 String
  photoUrl             String?
  notificationSettings String? // JSON string
  mustResetPassword    Boolean  @default(false)
  schoolId             String?
  school               School?  @relation(fields: [schoolId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  parentStudents Student[]      @relation("ParentStudents")
  driverTrips    Trip[]         @relation("DriverTrips")
  notifications  Notification[]

  @@index([schoolId])
  @@index([role])
}

model School {
  id            String   @id @default(uuid())
  name          String
  address       String?
  contactPerson String?
  city          String?
  state         String?
  phone         String?
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users    User[]
  buses    Bus[]
  routes   Route[]
  students Student[]
}

model Bus {
  id           String   @id @default(uuid())
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id])
  licensePlate String   @unique
  capacity     Int
  deviceId     String   @unique
  deviceSecret String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips   Trip[]
  gpsLogs GpsLog[]

  @@index([schoolId])
}

model Route {
  id                String   @id @default(uuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  name              String
  estimatedDuration Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stops RouteStop[]
  trips Trip[]

  @@index([schoolId])
}

model RouteStop {
  id        String   @id @default(uuid())
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name      String
  lat       Float
  lng       Float
  orderIdx  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentMappings StudentRouteMapping[]

  @@index([routeId, orderIdx])
}

model Student {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  rfidTag   String   @unique
  name      String
  grade     String?
  photoUrl  String?
  parentId  String?
  parent    User?    @relation("ParentStudents", fields: [parentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routeMappings     StudentRouteMapping[]
  attendanceLogs    AttendanceLog[]
  leaveApplications LeaveApplication[]

  @@index([schoolId])
  @@index([parentId])
}

model StudentRouteMapping {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routeStopId String
  routeStop   RouteStop @relation(fields: [routeStopId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([studentId, routeStopId])
  @@index([routeStopId])
}

model Trip {
  id                String    @id @default(uuid())
  routeId           String
  route             Route     @relation(fields: [routeId], references: [id])
  busId             String
  bus               Bus       @relation(fields: [busId], references: [id])
  driverId          String
  driver            User      @relation("DriverTrips", fields: [driverId], references: [id])
  status            String    @default("PLANNED")
  progressPercent   Int       @default(0)
  delayMinutes      Int       @default(0)
  currentEtaMessage String?
  startTime         DateTime?
  endTime           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  gpsLogs        GpsLog[]
  attendanceLogs AttendanceLog[]

  @@index([driverId, status])
  @@index([busId, status])
  @@index([routeId, status])
}

model GpsLog {
  id        String   @id @default(uuid())
  busId     String
  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id])
  lat       Float
  lng       Float
  speed     Float    @default(0)
  timestamp DateTime @default(now())

  @@index([busId, timestamp(sort: Desc)])
  @@index([timestamp])
}

model AttendanceLog {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  type      String
  timestamp DateTime @default(now())

  @@index([studentId, timestamp])
  @@index([tripId, timestamp])
}

model LeaveApplication {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String
  notes     String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@index([status, createdAt(sort: Desc)])
}

model EmergencyAlert {
  id        String   @id @default(uuid())
  schoolId  String
  type      String
  message   String?
  senderId  String?
  tripId    String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status])
  @@index([createdAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
}

model GlobalSettings {
  id              String   @id @default("global")
  maintenanceMode Boolean  @default(false)
  mapCenterLat    Float    @default(28.7041)
  mapCenterLng    Float    @default(77.1025)
  updatedAt       DateTime @updatedAt
}
