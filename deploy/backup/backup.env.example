# Copy to /etc/voltava/backup.env, chmod 600, owned by root:voltava.
#
# The database password does NOT belong here. Put it in ~voltava/.pgpass with
# mode 600 (host:port:db:user:password) so it never reaches a process listing or
# an environment dump:
#   echo 'localhost:5432:voltava_fleet:voltava:THE_PASSWORD' > ~voltava/.pgpass
#   chmod 600 ~voltava/.pgpass

PGHOST=localhost
PGPORT=5432
PGUSER=voltava
PGDATABASE=voltava_fleet

BACKUP_DIR=/var/backups/voltava
GCS_BUCKET=gs://voltava-fleet-backups
LOCAL_RETENTION_DAYS=3

# Scratch database the monthly drill restores into, then drops.
DRILL_DB=voltava_restore_drill
WORK_DIR=/var/tmp/voltava-drill
RESTORE_JOBS=2
